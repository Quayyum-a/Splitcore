// Splitcore — Phase 1 schema.
//
// Phase 1 only needs enough here to support authentication. The full domain
// model (venues, entertainers, QR codes, split rules, guest sessions, ledger
// accounts, payments, payouts, webhook events) is Phase 2 onward, per the PRD.
// Keeping this deliberately small now avoids modelling relationships before
// the entities on the other end of them exist.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  VENUE_ADMIN
  /// Read-only, and only ever over their own data. Entertainers have no
  /// password: they authenticate with a one-time link (see EntertainerLoginToken).
  ENTERTAINER
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REVIEW
  SUSPENDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
  REFUNDED
}

enum LedgerAccountType {
  ENTERTAINER_PAYABLE
  VENUE_PAYABLE
  PLATFORM_REVENUE
  PROCESSOR_CLEARING
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Lifecycle of a split rule. Only ACTIVE rules divide money.
enum SplitRuleStatus {
  /// Proposed by a venue; waiting on the entertainer. Never used to split.
  PENDING_ENTERTAINER_APPROVAL
  /// Agreed (or admin-forced) and in force.
  ACTIVE
  /// The entertainer declined. Kept for the audit trail, never activated.
  REJECTED
  /// Was ACTIVE, replaced by a later rule. effectiveTo is set.
  SUPERSEDED
  /// Proposed but replaced by a newer proposal before anyone responded.
  WITHDRAWN
}

/// How a split rule came to exist. An admin-forced rule must never be
/// indistinguishable from one both sides actually agreed to.
enum SplitRuleOrigin {
  /// Venue proposed venue/entertainer shares; entertainer accepted.
  VENUE_PROPOSAL
  /// Platform admin set all three shares directly. The exception.
  ADMIN_OVERRIDE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  venueId      String?  @map("venue_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  venue Venue? @relation(fields: [venueId], references: [id])

  @@map("users")
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  location  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  venueEntertainers   VenueEntertainer[]
  qrCodes             QrCode[]
  splitRules          SplitRule[]
  paymentTransactions PaymentTransaction[]

  @@map("venues")
}

model Entertainer {
  id            String    @id @default(uuid())
  stageName     String    @map("stage_name")
  legalName     String    @map("legal_name")
  phone         String    @unique
  bankName      String?   @map("bank_name")
  accountNumber String?   @map("account_number")
  kycStatus     KycStatus @default(NOT_STARTED) @map("kyc_status")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  /// Provider bank code (Paystack). Phase 2 stored only a free-text bankName
  /// and guessed the code from it; onboarding now captures the code itself.
  bankCode String? @map("bank_code")

  /// The account holder's name as the BANK reports it, never as anyone typed
  /// it. This is what the entertainer is shown and asked to confirm, which is
  /// the whole point of the resolve step.
  resolvedAccountName String?   @map("resolved_account_name")
  accountResolvedAt   DateTime? @map("account_resolved_at")

  /// Set when the entertainer confirms the resolved name really is them.
  /// Payouts require this: it is the difference between a verified destination
  /// and a typed-in number nobody checked.
  accountConfirmedAt DateTime? @map("account_confirmed_at")

  kycSubmittedAt    DateTime? @map("kyc_submitted_at")
  kycVerifiedAt     DateTime? @map("kyc_verified_at")
  /// Why verification failed or needs a human. Never contains identity numbers.
  kycFailureReason  String?   @map("kyc_failure_reason")
  /// Which identity document type was checked ("BVN" | "NIN"). The number
  /// itself is deliberately NOT stored - see IdentityProvider.
  identityCheckType String?   @map("identity_check_type")
  identityCheckedAt DateTime? @map("identity_checked_at")

  venueEntertainers   VenueEntertainer[]
  qrCodes             QrCode[]
  paymentTransactions PaymentTransaction[]
  splitRules          SplitRule[]
  loginTokens         EntertainerLoginToken[]

  @@map("entertainers")
}

model VenueEntertainer {
  id            String   @id @default(uuid())
  venueId       String   @map("venue_id")
  entertainerId String   @map("entertainer_id")
  createdAt     DateTime @default(now()) @map("created_at")

  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  entertainer Entertainer @relation(fields: [entertainerId], references: [id], onDelete: Cascade)

  @@unique([venueId, entertainerId])
  @@map("venue_entertainers")
}

model QrCode {
  id            String    @id @default(uuid())
  publicToken   String    @unique @map("public_token")
  venueId       String    @map("venue_id")
  entertainerId String?   @map("entertainer_id")
  location      String
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  venue         Venue          @relation(fields: [venueId], references: [id])
  entertainer   Entertainer?   @relation(fields: [entertainerId], references: [id])
  guestSessions GuestSession[]

  @@map("qr_codes")
}

model GuestSession {
  id        String   @id @default(uuid())
  qrCodeId  String   @map("qr_code_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  qrCode              QrCode               @relation(fields: [qrCodeId], references: [id])
  paymentTransactions PaymentTransaction[]

  @@map("guest_sessions")
}

model SplitRule {
  id             String    @id @default(uuid())
  venueId        String    @map("venue_id")
  entertainerBps Int       @map("entertainer_bps")
  venueBps       Int       @map("venue_bps")
  platformBps    Int       @map("platform_bps")
  /// Null while a proposal is unanswered: a rule that is not in force has no
  /// date from which it applied.
  effectiveFrom  DateTime? @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  status SplitRuleStatus @default(PENDING_ENTERTAINER_APPROVAL)
  origin SplitRuleOrigin @default(VENUE_PROPOSAL)

  /// The entertainer whose consent this proposal needs. Null only for an
  /// ADMIN_OVERRIDE, which bypasses consent by definition.
  entertainerId String? @map("entertainer_id")

  proposedByUserId String?   @map("proposed_by_user_id")
  proposedAt       DateTime  @default(now()) @map("proposed_at")
  respondedAt      DateTime? @map("responded_at")

  /// SHA-256 of the consent token. The token itself is shown once, on
  /// creation, and never stored: a leaked database cannot be used to consent
  /// on an entertainer's behalf.
  responseTokenHash String? @unique @map("response_token_hash")

  venue               Venue                 @relation(fields: [venueId], references: [id])
  entertainer         Entertainer?          @relation(fields: [entertainerId], references: [id])
  paymentTransactions PaymentTransaction[]
  auditEvents         SplitRuleAuditEvent[]

  @@index([venueId, effectiveFrom])
  @@index([venueId, status])
  @@map("split_rules")
}

/// Append-only history of everything that happened to a split rule: who
/// proposed it, who answered, when, and by what route. Enforced immutable by a
/// database trigger, the same way ledger_entries are - an audit trail that can
/// be edited is not an audit trail.
model SplitRuleAuditEvent {
  id          String   @id @default(uuid())
  splitRuleId String   @map("split_rule_id")
  event       String
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  splitRule SplitRule @relation(fields: [splitRuleId], references: [id])

  @@index([splitRuleId, createdAt])
  @@map("split_rule_audit_events")
}

/// Single-row table (id is pinned to 'singleton' by a database CHECK) holding
/// the platform's own cut. Only PLATFORM_ADMIN can change it; venue-scoped
/// callers can read it but have no code path that writes it.
model PlatformSettings {
  id              String   @id @default("singleton")
  platformFeeBps  Int      @default(500) @map("platform_fee_bps")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model PaymentTransaction {
  id                 String        @id @default(uuid())
  externalReference  String        @unique @map("external_reference")
  provider           String // "paystack" - string not enum for flexibility
  venueId            String        @map("venue_id")
  entertainerId      String?       @map("entertainer_id")
  guestSessionId     String        @map("guest_session_id")
  grossAmountKobo    Int           @map("gross_amount_kobo")
  guestDisplayName   String?       @map("guest_display_name")
  displayNameEnabled Boolean       @default(false) @map("display_name_enabled")
  // Split rule the guest was quoted under, snapshotted at initialization.
  // Settlement divides the money by THIS rule, never by whatever rule is
  // active when the webhook lands, so a venue editing its split mid-payment
  // can't change how an already-accepted payment is divided.
  splitRuleId        String?       @map("split_rule_id")
  status             PaymentStatus @default(CREATED)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  venue         Venue         @relation(fields: [venueId], references: [id])
  entertainer   Entertainer?  @relation(fields: [entertainerId], references: [id])
  guestSession  GuestSession  @relation(fields: [guestSessionId], references: [id])
  splitRule     SplitRule?    @relation(fields: [splitRuleId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  payouts       Payout[]

  @@index([externalReference])
  @@index([venueId])
  @@index([entertainerId])
  @@index([guestSessionId])
  @@index([status])
  @@map("payment_transactions")
}

model LedgerAccount {
  id        String            @id @default(uuid())
  type      LedgerAccountType
  ownerId   String?           @map("owner_id") // entertainerId or venueId; null for PLATFORM_REVENUE / PROCESSOR_CLEARING
  createdAt DateTime          @default(now()) @map("created_at")

  entries LedgerEntry[]
  payouts Payout[]

  // Owner-scoped accounts are unique via this index. System accounts
  // (owner_id NULL) are unique via a partial index in raw SQL, because
  // Postgres treats NULLs as distinct in a plain unique index.
  @@unique([type, ownerId])
  @@index([type])
  @@index([ownerId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String          @map("transaction_id") // FK to PaymentTransaction.id
  accountId     String          @map("account_id")
  direction     LedgerDirection
  amountKobo    Int             @map("amount_kobo")
  createdAt     DateTime        @default(now()) @map("created_at")

  account     LedgerAccount      @relation(fields: [accountId], references: [id])
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model WebhookEvent {
  id               String    @id @default(uuid())
  provider         String // "paystack"
  eventType        String    @map("event_type") // "charge.success", "transfer.success", etc.
  externalEventId  String    @unique @map("external_event_id") // Paystack's event ID
  signature        String
  payload          Json
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  processingStatus String    @default("PENDING") @map("processing_status") // PENDING, PROCESSING, COMPLETED, FAILED

  @@index([externalEventId])
  @@index([eventType])
  @@index([processingStatus])
  @@index([receivedAt])
  @@map("webhook_events")
}

enum PayoutStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
  CANCELLED
}

model Payout {
  id                String       @id @default(uuid())
  ledgerAccountId   String       @map("ledger_account_id")
  transactionId     String       @map("transaction_id")
  transferReference String?      @unique @map("transfer_reference")
  recipientCode     String?      @map("recipient_code") // Paystack recipient code
  amountKobo        Int          @map("amount_kobo")
  status            PayoutStatus @default(QUEUED)
  // Each transfer attempt gets its own reference (po_<id>_<attempt>), so a
  // retry after a definitive failure never collides with the old transfer,
  // while a retry after an ambiguous failure re-verifies the same reference.
  attempts          Int          @default(0)
  attemptedAt       DateTime?    @map("attempted_at")
  completedAt       DateTime?    @map("completed_at")
  failureReason     String?      @map("failure_reason")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  ledgerAccount      LedgerAccount      @relation(fields: [ledgerAccountId], references: [id])
  paymentTransaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  // One payout obligation per recipient account per payment. Retries reuse
  // the row; they never create a second obligation.
  @@unique([ledgerAccountId, transactionId])
  @@index([transactionId])
  @@index([status])
  @@map("payouts")
}

/// One-time login link for an entertainer.
///
/// Entertainers have no password. They get a link, tap it, and exchange it for
/// a short-lived read-only JWT - the same opaque-token discipline already used
/// for QR codes and split-rule consent, and for the same reason: the people
/// this is for are working a club floor, not managing credentials.
///
/// Only the token's SHA-256 hash is stored, so a leaked database cannot be used
/// to log in as an entertainer.
model EntertainerLoginToken {
  id            String    @id @default(uuid())
  entertainerId String    @map("entertainer_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  /// Set the moment it is redeemed. A second attempt with the same link fails.
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  entertainer Entertainer @relation(fields: [entertainerId], references: [id], onDelete: Cascade)

  @@index([entertainerId, createdAt])
  @@map("entertainer_login_tokens")
}
