# Production environment template.
#
# NEVER commit real values to this file — it is tracked in git. Set the real
# values in the Render dashboard (or your platform's secret store) only.

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://api.splitcore.app

# Comma-separated extra browser origins allowed by CORS, on top of the
# built-in production origins. Optional.
# ALLOWED_ORIGINS=https://app.splitcore.app

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Connection pooling parameters for Supabase with PgBouncer:
# - sslmode=require: SSL is mandatory for Supabase connections
# - pgbouncer=true: Use PgBouncer connection pooler
# - connection_limit=10: Maximum number of connections (matches Prisma pool config)
# - pool_timeout=20: Connection timeout in seconds
# - connect_timeout=20: Initial connection timeout in seconds
DATABASE_URL="postgresql://postgres:__DB_PASSWORD__@db.__PROJECT_REF__.supabase.co:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=20"

# Redis (Upstash)
# NEVER put real values in this file - it is committed to git.
# Set to false to run with NO Redis at all: no queue, and webhook events are
# processed inline on the request. A stopgap — the worker cannot run in this
# mode, so payouts accumulate as QUEUED rows until it is switched back on.
REDIS_ENABLED=true
# Copy the endpoint from the Upstash dashboard. Either form works — a bare
# host, or the full rediss:// connection URL; the app normalizes it.
REDIS_HOST=__YOUR_ENDPOINT__.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=__UPSTASH_PASSWORD__
# Optional. Unset = inferred (rediss:// scheme, or a password, means TLS).
# Set to false only for a plain-TCP Redis that still requires a password.
# REDIS_TLS=true

# Authentication
# Generate a secure random string (minimum 32 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=__GENERATE_A_32_PLUS_CHAR_RANDOM_STRING__
JWT_EXPIRES_IN=7d

# Monitoring (Sentry)
# Get the DSN from your Sentry project settings.
SENTRY_DSN=https://__PUBLIC_KEY__@__ORG__.ingest.us.sentry.io/__PROJECT_ID__
# Sample rate for performance monitoring (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100% of transactions
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
# Valid levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Origin of the guest/dashboard frontend. Payments return the guest to
# {FRONTEND_URL}/t/{publicToken}?reference=... so that page can poll
# GET /payments/:reference/status. Supersedes PAYMENT_CALLBACK_URL.
FRONTEND_URL=https://splitcore-app.netlify.app

# Paystack (Payment & Payout Provider)
# https://dashboard.paystack.com/#/settings/developer
# Test keys (sk_test_*, pk_test_*) for staging; live keys for production ONLY.
# Startup fails without these when NODE_ENV is production or staging.
PAYSTACK_SECRET_KEY=sk_live___YOUR_LIVE_SECRET_KEY__
PAYSTACK_PUBLIC_KEY=pk_live___YOUR_LIVE_PUBLIC_KEY__
# Where Paystack returns the guest after checkout. The redirect itself proves
# nothing, so whatever sits here must verify server-side.
# Until the guest frontend exists, point this at the API's own confirmation
# page, which re-verifies with Paystack and settles the payment:
#   https://api.splitcore.app/payments/callback
# Unset = the callback URL configured in the Paystack dashboard is used.
PAYMENT_CALLBACK_URL=https://api.splitcore.app/payments/callback
