# Application
NODE_ENV=production
PORT=3000
APP_URL=https://api.splitcore.app

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Connection pooling parameters for Supabase with PgBouncer:
# - sslmode=require: SSL is mandatory for Supabase connections
# - pgbouncer=true: Use PgBouncer connection pooler
# - connection_limit=10: Maximum number of connections (matches Prisma pool config)
# - pool_timeout=20: Connection timeout in seconds
# - connect_timeout=20: Initial connection timeout in seconds
DATABASE_URL="postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=20"

# Redis (Upstash)
# NEVER put real values in this file - it is committed to git.
# Get these values from your Upstash Redis dashboard
REDIS_HOST=rediss://your-instance.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-redis-password

# Authentication
# Generate a secure random string (minimum 32 characters)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-32-byte-random-hex-string
JWT_EXPIRES_IN=7d

# Monitoring (Sentry)
# Get DSN from your Sentry project settings
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# Sample rate for performance monitoring (0.0 to 1.0)
# 0.1 = 10% of transactions, 1.0 = 100% of transactions
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
# Valid levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Paystack (Payment & Payout Provider)
# Get these keys from your Paystack dashboard (https://dashboard.paystack.com/#/settings/developer)
# Use test keys (sk_test_*, pk_test_*) for staging
# Use live keys (sk_live_*, pk_live_*) for production ONLY
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
