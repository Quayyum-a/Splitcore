# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (Postgres via Prisma)
DATABASE_URL="postgresql://splitcore:splitcore@localhost:5432/splitcore_dev?schema=public"

# Redis (used by BullMQ)
# Set to false to run with NO Redis at all: no queue, and webhook events are
# processed inline on the request. A stopgap (provider quota exhausted, or
# local work without infrastructure) — the worker cannot run in this mode.
# REDIS_ENABLED=true
# A bare host or a full redis:// / rediss:// connection URL both work.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional. Unset = inferred (rediss:// scheme, or a password, means TLS).
# REDIS_TLS=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info

# Paystack (Payment & Payout Provider)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
# Where Paystack returns the guest after checkout. The redirect itself proves
# nothing, so whatever sits here must verify server-side.
# Until the guest frontend exists, point this at the API's own confirmation
# page, which re-verifies with Paystack and settles the payment:
#   http://localhost:3000/payments/callback
# Unset = the callback URL configured in the Paystack dashboard is used.
PAYMENT_CALLBACK_URL=http://localhost:3000/payments/callback
