# App
NODE_ENV=development
PORT=3000

# Database (Postgres via Prisma)
DATABASE_URL="postgresql://splitcore:splitcore@localhost:5432/splitcore_dev?schema=public"

# Redis (used by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info
